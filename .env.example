# These are set as Netlify environment variables (Site configuration > Environment
# variables), not read from a local .env file in production. This file documents what's
# needed; `netlify dev` will prompt you to link the site and pull them down for local dev.

# Required — get one at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Required — the single passcode that gates access to Kapehu (yours only). Pick
# anything you'll remember; it's not a per-user password system, just a shared
# lock so the same key works from any of your devices.
KAPEHU_PASSCODE=
